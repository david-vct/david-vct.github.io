---
import { serviceTechnologies, services } from "../../data/services"
import SectionHeading from "../components/SectionHeading.astro"
---

<section class="section container" id="services">
	<SectionHeading title="Services" stroke={0}>
		<p>Deux façons de collaborer en fonction du besoin.</p>
	</SectionHeading>

	<div class="services grid">
		{
			services.map((service, index) => (
				<article class="service" data-reveal style={`--delay: ${index * 0.12}s`}>
					<h3 class="title">{service.title}</h3>
					<p class="description">{service.description}</p>
					<ul class="items">
						{service.items.map((item) => <li>{item}</li>)}
					</ul>
				</article>
			))
		}
	</div>

	<ul class="technologies label muted" aria-label="Technologies" data-reveal>
		{serviceTechnologies.map((technology) => <li>{technology}</li>)}
	</ul>
</section>

<style>
	.services {
		row-gap: var(--space-9);
		padding-top: var(--space-6);
		border-top: var(--rule-thick) solid var(--color-contrast);
	}

	.title {
		max-width: 8em;
		margin-bottom: var(--space-6);
		font-size: var(--text-3xl);
		line-height: 1.05;
	}

	.description {
		max-width: 34rem;
		margin-bottom: var(--space-5);
		font-size: var(--text-lg);
		line-height: 1.36;
	}

	.items {
		display: grid;
		gap: var(--space-2);
		max-width: 34rem;
	}

	/* Square bullets in the accent colour. */
	.items li {
		position: relative;
		padding-left: var(--space-6);
	}

	.items li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.5em;
		height: 0.5em;
		background: var(--color-accent);
	}

	.technologies {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-5);
		margin-top: var(--space-9);
	}

	/* Phones: three columns, each as wide as its longest name, packed left. */
	@media (max-width: 767px) {
		.technologies {
			display: grid;
			grid-template-columns: repeat(3, auto);
			justify-content: start;
			column-gap: var(--space-4);
		}
	}

	@media (min-width: 768px) {
		.title {
			font-size: var(--text-4xl);
		}
	}

	@media (min-width: 1024px) {
		/* The two services side by side, titles on two lines each. */
		.service {
			grid-column: span 6;
		}

		.title {
			font-size: clamp(var(--text-4xl), 1rem + 3vw, 4.5rem);
		}
	}
</style>
