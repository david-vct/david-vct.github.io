---
import { getImage, Image } from "astro:assets"
import computer from "../../assets/computer-iso.webp"
import { clients } from "../../data/clients"
import { experience } from "../../data/experience"
import { profile } from "../../data/profile"
import { yearsSince } from "../../lib/dates"
import { computerBlob } from "../shapes"

// Experience counts from the first work-study contract.
const firstJob = experience.filter((job) => job.contract === "Alternance").at(-1) ?? experience[0]
const years = yearsSince(firstJob.period.start)
const freelanceSince = experience[0].period.start.slice(0, 4)

// Logos are drawn as masks, so only their shape is kept and the colour comes
// from the theme. SVGs are used as they are, bitmaps are resized. Heights
// shrink as logos widen, so they all weigh about the same.
const logos = await Promise.all(
	clients.map(async ({ name, logo }) => ({
		name,
		ratio: logo.width / logo.height,
		height: Math.round(68 / Math.sqrt(logo.width / logo.height)),
		src:
			logo.format === "svg"
				? logo.src
				: (await getImage({ src: logo, height: 112, format: "webp" })).src,
	})),
)
---

<section class="about section container" aria-label="Présentation">
	<div class="grid">
		<dl class="facts label" data-reveal>
			<div><dt class="muted">Basé à</dt><dd>{profile.location}</dd></div>
			<div><dt class="muted">Indépendant depuis</dt><dd>{freelanceSince}</dd></div>
			<div><dt class="muted">Expérience</dt><dd>{years} ans</dd></div>
		</dl>
		<p class="statement" data-reveal style="--delay: 0.1s">
			De la startup au grand groupe, on m’a confié des produits entiers comme des équipes à
			renforcer.
		</p>
		<div class="track track--products" data-reveal style="--delay: 0.2s">
			<h2 class="label">Produits livrés</h2>
			<p class="muted">
				J’ai pris en charge la conception et le développement intégrale de PadelGo, PadelGo Manager.
			</p>
		</div>
		<div class="track track--teams" data-reveal style="--delay: 0.28s">
			<h2 class="label">Équipes renforcées</h2>
			<p class="muted">
				J’ai rejoint les équipes de EDF et Groupe Adonis pour contribuer à leurs développements existants.
			</p>
		</div>
		<div class="computer" data-drift data-reveal style="--delay: 0.2s">
			<svg class="blob" viewBox={computerBlob.viewBox} aria-hidden="true" focusable="false">
				<g filter="url(#ink)"><path d={computerBlob.d}></path></g>
			</svg>
			<Image
				class="machine"
				src={computer}
				alt=""
				widths={[320, 560]}
				sizes="(min-width: 1024px) 260px, 60vw"
			/>
		</div>
	</div>

	<div class="clients" data-reveal>
		<h2 class="label">Ils m’ont fait confiance</h2>
		<ul>
			{
				logos.map((logo) => (
					<li>
						<span
							class="logo"
							role="img"
							aria-label={logo.name}
							style={`--logo: url("${logo.src}"); --ratio: ${logo.ratio}; --height: ${logo.height}px`}
						/>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.grid {
		row-gap: var(--space-7);
	}

	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-8);
		align-content: start;
	}

	.facts dd {
		font-size: var(--text-md);
	}

	.statement {
		font-family: var(--font-serif);
		font-size: var(--text-2xl);
		line-height: 1.15;
		text-wrap: balance;
	}

	.track {
		display: grid;
		gap: var(--space-3);
		align-content: start;
		max-width: 34rem;
	}

	/* A small extra: the computer stands on an ink blob, both drifting apart
	 * slightly under the pointer, like the portrait of the hero. */
	.computer {
		--pointer-x: 0;
		--pointer-y: 0;

		position: relative;
		width: min(60%, 260px);
		aspect-ratio: 1;
	}

	/* Laid flat under the base of the computer, like a ground it stands on. */
	.blob {
		position: absolute;
		top: 43%;
		left: 0%;
		width: 94%;
		height: auto;
		overflow: visible;
		transform: rotate(-3deg);
	}

	.blob path {
		fill: var(--color-accent);
	}

	/* Black and white at rest, back to colour under the pointer. */
	.machine {
		position: relative;
		width: 100%;
		filter: grayscale(1) contrast(1.1);
		transition: filter 0.7s var(--ease);
	}

	.computer:hover .machine {
		filter: grayscale(0) contrast(1);
	}

	.clients {
		display: grid;
		gap: var(--space-5);
		margin-top: var(--space-10);
		padding-top: var(--space-5);
		border-top: var(--rule-thick) solid var(--color-contrast);
	}

	.clients ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-6) var(--space-8);
	}

	/* Logos keep their shape only, painted in the text colour. */
	.logo {
		display: block;
		height: var(--height);
		width: calc(var(--height) * var(--ratio));
		background: var(--color-contrast);
		mask-image: var(--logo);
		mask-position: left center;
		mask-size: contain;
		mask-repeat: no-repeat;
	}

	@media (min-width: 768px) {
		.statement {
			font-size: var(--text-4xl);
		}
	}

	@media (min-width: 1024px) {
		.grid {
			row-gap: var(--space-9);
		}

		.facts {
			grid-column: 1 / span 3;
			grid-row: 1;
			flex-direction: column;
		}

		.statement {
			grid-column: 4 / span 9;
			grid-row: 1;
			font-size: clamp(var(--text-4xl), 1rem + 3.4vw, 4.5rem);
			line-height: 1.08;
		}

		/* Both tracks side by side, under the statement. */
		.track--products {
			grid-column: 4 / span 4;
		}

		.track--teams {
			grid-column: 8 / span 4;
		}

		/* Bottom left, in the space left under the facts. */
		.computer {
			grid-column: 1 / span 3;
			grid-row: 2;
			width: min(100%, 260px);
			margin-top: calc(var(--space-9) * -1);
		}

		.clients {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: var(--column-gap);
			align-items: center;
		}

		.clients h2 {
			grid-column: 1 / span 3;
		}

		.clients ul {
			grid-column: 4 / span 9;
			justify-content: space-between;
		}
	}

	/* Once revealed, the blob lands and the computer settles, as in the hero. */
	@keyframes land {
		from {
			opacity: 0;
			scale: 0.8;
			rotate: -12deg;
		}
	}

	@keyframes settle {
		from {
			opacity: 0;
			scale: 0.94;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(.js) .computer.is-visible .blob {
			animation: land 1.2s var(--ease) var(--delay) both;
		}

		:global(.js) .computer.is-visible .machine {
			animation: settle 1.1s var(--ease) calc(var(--delay) + 0.15s) both;
		}

		.blob {
			transition: translate 0.9s var(--ease);
			translate: calc(var(--pointer-x) * -3px) calc(var(--pointer-y) * -2px);
		}

		.machine {
			transition:
				filter 0.7s var(--ease),
				translate 0.9s var(--ease);
			translate: calc(var(--pointer-x) * 4px) calc(var(--pointer-y) * 3px);
		}
	}
</style>
