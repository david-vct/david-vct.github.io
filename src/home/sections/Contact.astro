---
import { profile } from "../../data/profile"
import Scribble from "../components/Scribble.astro"
import { underlines } from "../shapes"

const linkedin = profile.links.find((link) => link.href.includes("linkedin.com"))
---

<section class="contact on-accent grain" id="contact">
	<div class="container grid">
		<h2 data-reveal>
			<span>Une idée en tête&nbsp;?</span>
			<span>Parlons-en.</span>
		</h2>
		<div class="body" data-reveal style="--delay: 0.15s">
			<p class="lead">
				Un échange sans engagement nous permettra de comprendre vos besoins
                et de définir ensemble les prochaines étapes.
			</p>
			<a class="email" href={`mailto:${profile.email}`}>
				{profile.email}
				<Scribble class="underline" shape={underlines[1]} weight="0.09em" />
			</a>
			<div class="buttons buttons--stack">
				<a class="button" href={`mailto:${profile.email}`}>Écrire un e-mail</a>
				{linkedin && (
					<a class="button button--secondary" href={linkedin.href}>
						Écrire sur LinkedIn
					</a>
				)}
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		padding-block: var(--section-space);
	}

	.grid {
		row-gap: var(--space-8);
	}

	h2 {
		font-size: var(--text-section);
		line-height: 0.92;
	}

	/* "Une idée en tête ?" stays on one line: it is about 5.6em wide, so the
	 * title shrinks below its usual size when the column is narrower. */
	h2 {
		container-type: inline-size;
	}

	h2 > span {
		display: block;
		font-size: min(1em, 16.5cqi);
		white-space: nowrap;
	}

	.body {
		display: grid;
		gap: var(--space-7);
		justify-items: start;
		align-content: end;
	}

	.lead {
		max-width: 30rem;
		font-size: var(--text-lg);
		line-height: 1.36;
	}

	.email {
		position: relative;
		z-index: 0;
		display: inline-block;
		font-size: clamp(var(--text-lg), 1rem + 2vw, var(--text-2xl));
		font-stretch: 115%;
		font-weight: 600;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	/* Scoped styles do not reach a class handed to a child component. */
	/* Behind the letters, like the section titles. */
	.email :global(.underline) {
		position: absolute;
		z-index: -1;
		left: -2%;
		bottom: -0.32em;
		width: 104%;
		max-width: none;
		height: auto;
	}

	@media (min-width: 1024px) {
		h2 {
			grid-column: 1 / span 8;
			align-self: center;
		}

		.body {
			grid-column: 9 / span 4;
		}
	}
</style>
