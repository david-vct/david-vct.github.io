---
import { Image } from "astro:assets"
import portrait from "../../assets/portrait.webp"
import { profile } from "../../data/profile"
import { accentBlob, portraitBlob } from "../shapes"

const [city] = profile.location.split(",")
const [blobWidth, blobHeight] = portraitBlob.viewBox.split(" ").slice(2).map(Number)
---

<section class="hero container grid" id="top">
	<p class="byline label">
		<span>{profile.name}</span>
		<span class="muted">Freelance · {city}</span>
	</p>

	<h1 class="headline">
		<span class="line"><span>Développeur</span></span>{" "}
		<span class="line line--offset"><span>web et mobile</span></span>
	</h1>

	<div class="portrait" data-drift>
		<svg class="accent" viewBox={accentBlob.viewBox} aria-hidden="true" focusable="false">
			<g filter="url(#ink)"><path d={accentBlob.d}></path></g>
		</svg>
		<svg class="clip" width="0" height="0" aria-hidden="true" focusable="false">
			<clipPath
				id="portrait-clip"
				clipPathUnits="objectBoundingBox"
				transform={`scale(${1 / blobWidth} ${1 / blobHeight})`}
			>
				<path d={portraitBlob.d}></path>
			</clipPath>
		</svg>
		<Image
			class="photo"
			src={portrait}
			alt={`Portrait de ${profile.name}`}
			widths={[480, 720, 960, portrait.width]}
			sizes="(min-width: 1024px) 38vw, 82vw"
			quality={85}
			loading="eager"
			fetchpriority="high"
		/>
	</div>

	<div class="pitch">
		<p class="lead">J’aide les PME à créer les applications dont elles ont besoin.</p>
		<div class="buttons buttons--stack">
			<a class="button" href="#contact">Me contacter</a>
			<a class="button button--secondary" href="#projets">Voir les projets</a>
		</div>
	</div>
</section>

<style>
	.hero {
		--headline-size: calc((100vw - 2 * var(--gutter)) / 5.1);

		min-height: 100svh;
		align-content: center;
		row-gap: var(--space-6);
		padding-top: calc(var(--header-height) + var(--space-7));
		padding-bottom: var(--space-8);
	}

	.byline > span {
		display: block;
	}

	/* The headline overlaps the portrait: it lets the pointer through, so the
	 * portrait still reacts underneath. A soft shadow keeps it legible over
	 * the light parts of the photo. Its lines nest into each other, tighter
	 * than the other display titles.
	 *
	 * Its size is off the type scale: it follows the width of the page, so its
	 * second line, the widest ("web et mobile" plus its offset), always ends
	 * at the same place. Below 1024 px it fills the width. */
	.headline {
		--offset: .5em;

		position: relative;
		z-index: 1;
		pointer-events: none;
		font-size: var(--headline-size);
		line-height: 0.8;
		letter-spacing: var(--tracking-display);
		text-shadow: 0 0.02em 0.18em color-mix(in srgb, var(--color-base) 45%, transparent);
	}

	/* Each line is a window the words rise through on load, deep enough for
	 * the descender of "Développeur". */
	.line {
		display: block;
		overflow: clip;
		padding-block: 0.04em 0.24em;
		margin-bottom: -0.24em;
		white-space: nowrap;
	}

	.line > span {
		display: inline-block;
	}

	.line--offset {
		padding-left: var(--offset);
	}

	.portrait {
		--pointer-x: 0;
		--pointer-y: 0;

		position: relative;
		justify-self: end;
		width: min(82%, 440px);
		aspect-ratio: 500 / 560;
	}

	.accent {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		transform: translate(-9%, 6%) rotate(-6deg);
	}

	.accent path {
		fill: var(--color-accent);
	}

	.clip {
		position: absolute;
	}

	/* Black and white at rest, back to colour under the pointer. */
	.photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		clip-path: url(#portrait-clip);
		filter: grayscale(1) contrast(1.1);
		transition: filter 0.7s var(--ease);
	}

	.portrait:hover .photo {
		filter: grayscale(0) contrast(1);
	}

	/* The tagline: a lead set at title size. */
	.lead {
		max-width: 22ch;
		margin-bottom: var(--space-6);
		font-size: var(--step-3);
		line-height: var(--leading-title);
	}

	/* Below 1024 px the portrait is pulled up under the end of the headline,
	 * deeper on phones where it is centred and its top is narrower. */
	@media (max-width: 1023px) {
		.portrait {
			margin-top: calc(var(--headline-size) * -0.6);
		}
	}

	/* Phones: byline, headline and portrait centred, a component's spacing
	 * apart. The headline shrinks to its widest line, so the second one keeps
	 * its offset. */
	@media (max-width: 767px) {
		.hero {
			row-gap: var(--space-7);
		}

		.byline {
			justify-self: center;
			text-align: center;
		}

		.headline,
		.portrait {
			justify-self: center;
		}

		.portrait {
			margin-top: calc(var(--headline-size) * -0.3 - var(--space-7));
		}
	}

	/* The second line of the headline runs over the left edge of the
	 * portrait, about a tenth of its width. */
	@media (min-width: 1024px) {
		.hero {
			--headline-size: calc((min(100vw, var(--container)) - 2 * var(--gutter)) * 0.114);

			grid-template-rows: auto auto auto;
			row-gap: var(--space-7);
		}

		.byline {
			grid-column: 1 / span 6;
			grid-row: 1;
		}

		.headline {
			--offset: 1em;

			grid-column: 1 / span 9;
			grid-row: 2;
		}

		.portrait {
			grid-column: 8 / span 5;
			grid-row: 1 / span 3;
			align-self: center;
			width: 100%;
		}

		.pitch {
			grid-column: 1 / span 6;
			grid-row: 3;
		}
	}

	/* Load sequence: the name rises, the blob lands, the photo settles, then
	 * the text. */
	@keyframes rise {
		from {
			translate: 0 105%;
		}
	}

	@keyframes land {
		from {
			opacity: 0;
			scale: 0.8;
			rotate: -12deg;
		}
	}

	@keyframes settle {
		from {
			opacity: 0;
			scale: 0.94;
		}
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			translate: 0 1.5rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.line > span {
			animation: rise 1s var(--ease) 0.1s both;
		}

		.line--offset > span {
			animation-delay: 0.22s;
		}

		.accent {
			animation: land 1.2s var(--ease) 0.25s both;
		}

		.photo {
			animation: settle 1.1s var(--ease) 0.4s both;
		}

		.byline {
			animation: fade-up 0.8s var(--ease) 0.55s both;
		}

		.pitch {
			animation: fade-up 0.8s var(--ease) 0.7s both;
		}

		/* Under the pointer, photo and blob drift in opposite directions. */
		.accent {
			transition: translate 0.6s var(--ease);
		}

		.photo {
			transition:
				filter 0.7s var(--ease),
				translate 0.6s var(--ease);
			translate: calc(var(--pointer-x) * 10px) calc(var(--pointer-y) * 8px);
		}

		.accent {
			translate: calc(var(--pointer-x) * -18px) calc(var(--pointer-y) * -14px);
		}
	}
</style>
