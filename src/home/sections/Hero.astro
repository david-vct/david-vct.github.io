---
import { Image } from "astro:assets"
import portrait from "../../assets/portrait.webp"
import { profile } from "../../data/profile"
import { accentBlob, portraitBlob } from "../shapes"

const [firstName, ...lastNames] = profile.name.split(" ")
const [blobWidth, blobHeight] = portraitBlob.viewBox.split(" ").slice(2).map(Number)
---

<section class="hero container grid" id="top">
	<p class="role label">Ingénieur logiciel indépendant</p>

	<h1 class="name">
		<span class="line"><span>{firstName}</span></span>{" "}
		<span class="line line--offset"><span>{lastNames.join(" ")}</span></span>
	</h1>

	<div class="portrait" data-drift>
		<svg class="accent" viewBox={accentBlob.viewBox} aria-hidden="true" focusable="false">
			<g filter="url(#ink)"><path d={accentBlob.d}></path></g>
		</svg>
		<svg class="clip" width="0" height="0" aria-hidden="true" focusable="false">
			<clipPath
				id="portrait-clip"
				clipPathUnits="objectBoundingBox"
				transform={`scale(${1 / blobWidth} ${1 / blobHeight})`}
			>
				<path d={portraitBlob.d}></path>
			</clipPath>
		</svg>
		<Image
			class="photo"
			src={portrait}
			alt={`Portrait de ${profile.name}`}
			widths={[480, 720, 960, portrait.width]}
			sizes="(min-width: 1024px) 38vw, 82vw"
			quality={85}
			loading="eager"
			fetchpriority="high"
		/>
	</div>

	<div class="pitch">
		<p class="lead">J’aide les PME à créer les applications web et mobiles dont elles ont besoin.</p>
		<div class="buttons buttons--stack">
			<a class="button" href="#contact">Me contacter</a>
			<a class="button button--secondary" href="#projets">Voir les projets</a>
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100svh;
		align-content: center;
		row-gap: var(--space-6);
		padding-top: calc(var(--header-height) + var(--space-8));
		padding-bottom: var(--space-9);
	}

	/* The name overlaps the portrait: it lets the pointer through, so the
	 * portrait still reacts underneath. */
	.name {
		position: relative;
		z-index: 1;
		pointer-events: none;
		font-size: var(--text-hero);
		line-height: 0.8;
		letter-spacing: -0.02em;
	}

	/* Each line is a window the word rises through on load. */
	.line {
		display: block;
		overflow: clip;
		padding-block: 0.04em 0.1em;
		margin-bottom: -0.1em;
	}

	.line > span {
		display: inline-block;
	}

	.line--offset {
		padding-left: 0.6em;
	}

	.portrait {
		--pointer-x: 0;
		--pointer-y: 0;

		position: relative;
		justify-self: end;
		width: min(82%, 440px);
		aspect-ratio: 500 / 560;
	}

	.accent {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		transform: translate(-9%, 6%) rotate(-6deg);
	}

	.accent path {
		fill: var(--color-accent);
	}

	.clip {
		position: absolute;
	}

	/* Black and white at rest, back to colour under the pointer. */
	.photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		clip-path: url(#portrait-clip);
		filter: grayscale(1) contrast(1.1);
		transition: filter 0.7s var(--ease);
	}

	.portrait:hover .photo {
		filter: grayscale(0) contrast(1);
	}

	.lead {
		max-width: 22ch;
		margin-bottom: var(--space-6);
		font-size: var(--text-xl);
		line-height: 1.25;
	}

	/* Phones: name and portrait centred. The name shrinks to its widest line,
	 * so the second one keeps its offset. */
	@media (max-width: 767px) {
		.name,
		.portrait {
			justify-self: center;
		}
	}

	@media (min-width: 768px) {
		.lead {
			font-size: var(--text-2xl);
		}
	}

	@media (min-width: 1024px) {
		.hero {
			grid-template-rows: auto auto auto;
			row-gap: var(--space-7);
		}

		.role {
			grid-column: 1 / span 6;
			grid-row: 1;
		}

		.name {
			grid-column: 1 / span 9;
			grid-row: 2;
		}

		.line--offset {
			padding-left: 1.1em;
		}

		.portrait {
			grid-column: 8 / span 5;
			grid-row: 1 / span 3;
			align-self: center;
			width: 100%;
		}

		.pitch {
			grid-column: 1 / span 6;
			grid-row: 3;
		}

		.lead {
			font-size: var(--text-3xl);
			line-height: 1.19;
		}
	}

	/* Load sequence: the name rises, the blob lands, the photo settles, then
	 * the text. */
	@keyframes rise {
		from {
			translate: 0 105%;
		}
	}

	@keyframes land {
		from {
			opacity: 0;
			scale: 0.8;
			rotate: -12deg;
		}
	}

	@keyframes settle {
		from {
			opacity: 0;
			scale: 0.94;
		}
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			translate: 0 1.5rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.line > span {
			animation: rise 1s var(--ease) 0.1s both;
		}

		.line--offset > span {
			animation-delay: 0.22s;
		}

		.accent {
			animation: land 1.2s var(--ease) 0.25s both;
		}

		.photo {
			animation: settle 1.1s var(--ease) 0.4s both;
		}

		.role {
			animation: fade-up 0.8s var(--ease) 0.55s both;
		}

		.pitch {
			animation: fade-up 0.8s var(--ease) 0.7s both;
		}

		/* Under the pointer, photo and blob drift in opposite directions. */
		.accent {
			transition: translate 0.6s var(--ease);
		}

		.photo {
			transition:
				filter 0.7s var(--ease),
				translate 0.6s var(--ease);
			translate: calc(var(--pointer-x) * 10px) calc(var(--pointer-y) * 8px);
		}

		.accent {
			translate: calc(var(--pointer-x) * -18px) calc(var(--pointer-y) * -14px);
		}
	}
</style>
