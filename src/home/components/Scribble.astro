---
// A hand-drawn stroke. It draws itself when its nearest [data-reveal]
// ancestor comes into view (see styles.css).
import type { Shape } from "../shapes"

interface Props {
	shape: Shape
	class?: string
	/**
	 * Stroke width as a CSS length. It does not scale with the drawing, so in
	 * em it follows the size of the text it underlines, whatever its length.
	 */
	weight?: string
	/** Stretch the shape to its box instead of keeping its proportions. */
	stretch?: boolean
}

const { shape, class: className, weight = "0.05em", stretch = false } = Astro.props
// Displacing a stretched stroke jitters it, so those keep their own wobble.
const filter = stretch ? undefined : "url(#ink-line)"
---

<svg
	class:list={["scribble", className]}
	viewBox={shape.viewBox}
	preserveAspectRatio={stretch ? "none" : undefined}
	aria-hidden="true"
	focusable="false"
>
	<g filter={filter}>
		<path d={shape.d} pathLength="1" style={`stroke-width: ${weight}`} vector-effect="non-scaling-stroke"></path>
	</g>
</svg>
