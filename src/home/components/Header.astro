---
import { Image } from "astro:assets"
import icon from "../../assets/icon.png"
import { profile } from "../../data/profile"
import { navigation } from "../navigation"
---

<header class="header">
	<div class="container header-inner">
		<a class="name" href="#top">
			<Image class="icon" src={icon} alt="" width={32} height={32} densities={[1, 2]} loading="eager" />
			{profile.name}
		</a>
		<nav aria-label="Sections de la page">
			<ul class="label">
				{
					navigation.map((item) => (
						<li>
							<a href={`#${item.id}`}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a class="button button--small" href="#contact">Me contacter</a>
	</div>
</header>

<style>
	.header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 10;
		background: var(--color-base);
	}

	.header-inner {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		height: var(--header-height);
	}

	.name {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin-right: auto;
		font-family: var(--font-serif);
		font-size: var(--step-1);
		line-height: 1;
		text-decoration: none;
	}

	.icon {
		width: 32px;
		height: 32px;
	}

	nav {
		display: none;
	}

	ul {
		display: flex;
		gap: var(--space-6);
	}

	nav a {
		text-decoration: none;
	}

	nav a:hover {
		text-decoration: underline;
		text-decoration-thickness: var(--rule-thick);
	}

	/* Phones: the name stays on one line beside the button. On the narrowest
	 * screens, the icon makes way for it. */
	@media (max-width: 767px) {
		.header-inner {
			gap: var(--space-4);
		}

		.name {
			white-space: nowrap;
		}
	}

	@media (max-width: 339px) {
		.icon {
			display: none;
		}
	}

	@media (min-width: 900px) {
		nav {
			display: block;
		}
	}
</style>
