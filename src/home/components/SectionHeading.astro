---
// Title of a section, underlined by a marker stroke, with an optional
// introduction set beside it on wide screens.
import { underlines } from "../shapes"
import Scribble from "./Scribble.astro"

interface Props {
	title: string
	/** Which of the hand-drawn underlines to use, so neighbours differ. */
	stroke: number
}

const { title, stroke } = Astro.props
const hasIntro = Astro.slots.has("default")
---

<div class="heading grid">
	<h2 class="title-1" data-reveal>
		<span class="title">
			{title}
			<Scribble class="underline" shape={underlines[stroke % underlines.length]} weight="0.045em" />
		</span>
	</h2>
	{
		hasIntro && (
			<div class="intro lead muted" data-reveal style="--delay: 0.12s">
				<slot />
			</div>
		)
	}
</div>

<style>
	.heading {
		row-gap: var(--space-6);
		margin-bottom: var(--space-8);
	}

	/* Own stacking context, so the underline can sit behind the letters
	 * (descenders cross over it) without dropping behind the page. */
	.title {
		position: relative;
		z-index: 0;
		display: inline-block;
	}

	/* Scoped styles do not reach a class handed to a child component. */
	.title :global(.underline) {
		position: absolute;
		z-index: -1;
		left: -2%;
		bottom: -0.16em;
		width: 104%;
		height: auto;
		color: var(--color-accent);
	}

	.intro {
		max-width: 34rem;
	}

	/* The introduction only shows beside the title: once they would stack, it
	 * is dropped and the title moves closer to the rule below. */
	@media (max-width: 1023px) {
		.heading {
			margin-bottom: var(--space-6);
		}

		.intro {
			display: none;
		}
	}

	@media (min-width: 1024px) {
		.heading {
			align-items: end;
			margin-bottom: var(--space-9);
		}

		h2 {
			grid-column: 1 / span 8;
		}

		.intro {
			grid-column: 9 / span 4;
		}
	}
</style>
