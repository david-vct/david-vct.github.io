---
import { profile } from "../data/profile"
import Footer from "../home/components/Footer.astro"
import Header from "../home/components/Header.astro"
import Layout from "../home/Layout.astro"
import About from "../home/sections/About.astro"
import Career from "../home/sections/Career.astro"
import Contact from "../home/sections/Contact.astro"
import Hero from "../home/sections/Hero.astro"
import Lab from "../home/sections/Lab.astro"
import Projects from "../home/sections/Projects.astro"
import Services from "../home/sections/Services.astro"
---

<Layout
	title={`${profile.name}, développeur web et mobile indépendant`}
	description="David Vicente, ingénieur logiciel indépendant à Toulouse : conception et développement d’applications web et mobiles pour les PME et les startups, renfort d’équipes de développement."
>
	<Header />
	<main>
		<Hero />
		<About />
		<Services />
		<Projects />
		<Lab />
		<Career />
		<Contact />
	</main>
	<Footer />
</Layout>
