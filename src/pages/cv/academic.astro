---
import Lightbox from "../../cv-academic/components/Lightbox.astro"
import Masthead from "../../cv-academic/components/Masthead.astro"
import Section from "../../cv-academic/components/Section.astro"
import Layout from "../../cv-academic/Layout.astro"
import Education from "../../cv-academic/sections/Education.astro"
import Experience from "../../cv-academic/sections/Experience.astro"
import Products from "../../cv-academic/sections/Products.astro"
import Profile from "../../cv-academic/sections/Profile.astro"
import Projects from "../../cv-academic/sections/Projects.astro"
import Skills from "../../cv-academic/sections/Skills.astro"
import { profile } from "../../data/profile"
import { formatMonthYear } from "../../lib/dates"

const sections = [
	{ id: "profil", title: "Profil", Content: Profile },
	{ id: "realisations", title: "Réalisations professionnelles", Content: Products },
	{ id: "experience", title: "Expérience professionnelle", Content: Experience },
	{ id: "formation", title: "Formation", Content: Education },
	{
		id: "projets",
		title: "Logiciels libres et projets personnels",
		Content: Projects,
	},
	{ id: "competences", title: "Compétences", Content: Skills },
]

const buildDate = new Date()
---

<Layout title={`${profile.name}, curriculum vitae`} description={profile.description}>
	<main>
		<Masthead />
		{
			sections.map(({ id, title, Content }) => (
				<Section id={id} title={title}>
					<Content />
				</Section>
			))
		}
		<footer>
			<p>
				©&nbsp;{buildDate.getFullYear()} {profile.name}. Tous droits réservés.
			</p>
			<p>
				Dernière mise à jour&nbsp;: {formatMonthYear(buildDate)}.{" "}
				<a href="https://github.com/david-vct/david-vct.github.io">Sources</a> de
				cette page.
			</p>
		</footer>
	</main>
	<Lightbox />
</Layout>

<style>
	footer {
		margin-top: 3.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.875rem;
	}

	footer p + p {
		margin-top: 0.15rem;
	}

	@media print {
		footer a {
			display: none;
		}
	}
</style>
