---
import { experience } from "../../data/experience"
import { cite } from "../bibliography"
import { formatPeriod } from "../../lib/dates"
import Entry from "../components/Entry.astro"
---

{
	experience.map((job) => (
		<Entry
			title={job.organization}
			place={job.location}
			aside={formatPeriod(job.period)}
			subtitle={[job.role, job.contract.toLowerCase()].filter(Boolean).join(", ")}
		>
			<ul class="dashed">
				{job.items.map((item) => (
					<li>{item}</li>
				))}
			</ul>
			{job.technologies && (
				<p>Environnement&nbsp;: {job.technologies.join(", ")}.</p>
			)}
			{job.related && (
				<p>
					Travaux associés&nbsp;:{" "}
					{job.related.map(cite).map((citation, index) => (
						<>
							{index > 0 && ", "}
							<a href={citation.href}>{citation.title}</a>
						</>
					))}
					.
				</p>
			)}
		</Entry>
	))
}
