---
// One entry of the CV. Its date hangs in the margin column, facing the
// first line: the title in bold, then where it took place.
interface Props {
	title: string
	place?: string
	aside?: string
	subtitle?: string
	id?: string
}

const { title, place, aside, subtitle, id } = Astro.props
---

<article class="entry hang" id={id}>
	{aside && <span class="aside in-margin">{aside}</span>}
	<h3 class="title">
		<strong>{title}</strong>{place && <> – {place}</>}
	</h3>
	{subtitle && <p class="subtitle">{subtitle}</p>}
	<div class="body"><slot /></div>
</article>

<style>
	.entry {
		scroll-margin-top: 1.5rem;
	}

	.entry + :global(.entry) {
		margin-top: 1.05em;
	}

	.aside {
		font-variant-numeric: lining-nums tabular-nums;
	}

	.title {
		margin: 0;
		font-size: inherit;
	}

	/* The date faces the title line. */
	@media (min-width: 52.8rem), print {
		.aside {
			grid-row: 1;
		}

		.title {
			grid-row: 1;
		}
	}

	@media print {
		.entry {
			break-inside: avoid;
		}
	}
</style>
