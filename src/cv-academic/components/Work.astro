---
import { projectAnchor, type NumberedProject } from "../bibliography"
import { formatPeriod } from "../../lib/dates"
import Entry from "./Entry.astro"
import Figure from "./Figure.astro"

interface Props {
	project: NumberedProject
}

const { project } = Astro.props

// Portrait and landscape figures together are set at equal height, each as
// wide as its proportions ask, rather than in fixed columns.
const ratios = project.figures.map(({ image }) => image.width / image.height)
const mixed = ratios.some((ratio) => ratio < 1) && ratios.some((ratio) => ratio > 1)
const total = ratios.reduce((sum, ratio) => sum + ratio, 0)
---

<Entry
	id={projectAnchor(project.id)}
	title={project.title}
	aside={formatPeriod(project.period)}
>
	<p>{project.description}</p>
	<p>
		{project.technologies.join(", ")}.
		{
			project.links?.map((link) => (
				<>
					{" "}
					[<a href={link.href}>{link.label}</a>]
				</>
			))
		}
	</p>
	{
		project.figures.length > 0 && (
			<div class:list={["figures", { portrait: project.portrait, mixed }]}>
				{project.figures.map((figure, index) => (
					<Figure
						figure={figure}
						work={project.title}
						share={mixed ? ratios[index] / total : undefined}
					/>
				))}
			</div>
		)
	}
</Entry>

<style>
	.figures {
		display: grid;
		/* Fixed columns, so every figure of a kind has the same width. */
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		align-items: start;
		margin-top: 0.75rem;
	}

	.figures.portrait {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.figures.mixed {
		display: flex;
	}

	@media screen and (max-width: 52.799rem) {
		.figures {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.figures.portrait {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
