---
// Shows a figure enlarged over the page. Figure links (`a[data-lightbox]`)
// still point at the full-size image, so without JavaScript they open it
// directly.
---

<dialog class="lightbox" aria-label="Figure agrandie">
	<figure>
		<img alt="" />
		<figcaption></figcaption>
	</figure>
	<button type="button" class="close" aria-label="Fermer">×</button>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>("dialog.lightbox")!
	const image = dialog.querySelector("img")!
	const caption = dialog.querySelector("figcaption")!

	const open = (link: HTMLAnchorElement) => {
		const thumbnail = link.querySelector("img")
		// Starts from the thumbnail, already loaded, and swaps in the full-size
		// image once it has arrived.
		image.src = thumbnail?.currentSrc || link.href
		image.alt = thumbnail?.alt ?? ""
		const full = new Image()
		full.onload = () => {
			if (dialog.open && link === current) image.src = full.src
		}
		full.src = link.href
		caption.innerHTML = link.closest("figure")?.querySelector("figcaption")?.innerHTML ?? ""
		current = link
		dialog.showModal()
	}

	let current: HTMLAnchorElement | null = null

	document.addEventListener("click", (event) => {
		const link = (event.target as Element).closest<HTMLAnchorElement>("a[data-lightbox]")
		if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return
		event.preventDefault()
		open(link)
	})

	// Anything but the image and its caption is the veil.
	dialog.addEventListener("click", (event) => {
		if (!(event.target as Element).closest("img, figcaption")) dialog.close()
	})

	dialog.addEventListener("close", () => {
		current?.focus()
		current = null
	})
</script>

<style>
	.lightbox {
		position: fixed;
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 2.5rem 1rem 1.5rem;
		border: 0;
		background: transparent;
		color: #ece9e1;
	}

	.lightbox[open] {
		display: flex;
		align-items: center;
		justify-content: center;
		animation: fade 160ms ease-out;
	}

	.lightbox::backdrop {
		background: rgb(20 19 17 / 0.86);
		animation: fade 160ms ease-out;
	}

	figure {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 100%;
		max-height: 100%;
		margin: 0;
		animation: rise 200ms cubic-bezier(0.2, 0.7, 0.3, 1);
	}

	img {
		min-height: 0;
		max-width: min(100%, 72rem);
		/* Leaves room for the caption. */
		max-height: calc(100dvh - 10rem);
		object-fit: contain;
		border-radius: var(--radius);
		box-shadow: 0 0.5rem 2.5rem rgb(0 0 0 / 0.35);
	}

	figcaption {
		flex: none;
		max-width: 38rem;
		margin-top: 0.9rem;
		font-size: 0.9375rem;
		line-height: 1.45;
		text-align: center;
	}

	figcaption :global(.label) {
		color: #fff;
		font-variant-caps: small-caps;
		font-weight: 700;
	}

	.close {
		position: absolute;
		top: 0.5rem;
		right: 0.75rem;
		padding: 0 0.4rem;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		font-size: 1.75rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0.7;
	}

	.close:hover,
	.close:focus-visible {
		opacity: 1;
	}

	.close:focus-visible {
		outline: 1px solid currentColor;
		outline-offset: 2px;
	}

	:global(html:has(.lightbox[open])) {
		overflow: hidden;
	}

	@keyframes fade {
		from {
			opacity: 0;
		}
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: scale(0.97);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.lightbox[open],
		.lightbox::backdrop,
		figure {
			animation: none;
		}
	}
</style>
