---
import { Image } from "astro:assets"
import portrait from "../assets/portrait.png"
import { profile } from "../data/profile"
---

<header class="masthead">
	<div>
		<h1>{profile.name}</h1>
		<p class="title">{profile.title}</p>
		<address>
			{profile.location}<br />
			<a href={`mailto:${profile.email}`}>{profile.email}</a><br />
			{
				profile.links.map((link, index) => (
					<>
						{index > 0 && " · "}
						<a href={link.href}>{link.label}</a>
					</>
				))
			}
		</address>
	</div>
	<Image
		class="portrait"
		src={portrait}
		alt={`Portrait de ${profile.name}`}
		width={240}
		widths={[120, 240]}
		sizes="120px"
		loading="eager"
	/>
</header>

<style>
	.masthead {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 1.5rem;
		align-items: end;
	}

	h1 {
		margin: 0;
		font-size: 2.25rem;
		font-weight: 600;
		letter-spacing: -0.005em;
	}

	.title {
		margin-top: 0.15rem;
		color: var(--ink-soft);
		font-size: 1.15rem;
		font-style: italic;
	}

	address {
		margin-top: 0.9rem;
		font-style: normal;
		color: var(--muted);
		line-height: 1.5;
	}

	.portrait {
		width: 7.5rem;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: var(--radius);
		filter: grayscale(0.25);
	}

	@media (max-width: 30rem) {
		h1 {
			font-size: 1.85rem;
		}

		.portrait {
			width: 5rem;
			align-self: start;
		}
	}
</style>
